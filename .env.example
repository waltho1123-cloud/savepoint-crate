# 複製成 .env 後填入真實值；.env 不進版控（已列入 .gitignore）。
# 本機開發：pnpm dev 會自動載入 .env。正式環境請在 Zeabur 服務的環境變數頁設定，不要把真實值寫進 repo。

# 必填：OpenAI API 金鑰（拍照辨識用）。
# 未設定時服務仍會啟動，但 POST /api/ocr 會回 503，GET /healthz 的 openaiConfigured 為 false。
OPENAI_API_KEY=replace-with-your-openai-api-key

# 選填：OpenAI 相容端點（不含 /v1，結尾不要加斜線）。預設 https://api.openai.com
OPENAI_BASE_URL=https://api.openai.com

# 選填：辨識使用的模型。預設 gpt-5.6-luna（與原 n8n 工作流相同）
OPENAI_MODEL=gpt-5.6-luna

# 必填：Google 服務帳號金鑰（JSON 原文，或整包 JSON 的 base64 都可以；Zeabur 上建議用 base64）。
# 產生 base64：base64 < service-account.json | tr -d '\n'
# 未設定或格式無法解析時服務仍會啟動，但 POST /api/save 會回 503，
# GET /healthz 的 sheetsConfigured 為 false、serviceAccountEmail 為 null。
# 服務帳號的 client_email（可從 GET /healthz 的 serviceAccountEmail 看到）必須被加為試算表的「編輯者」。
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=replace-with-service-account-json-or-base64

# 選填：寫入的試算表 ID 與分頁名稱。預設就是目前使用的「商品主檔」。
GOOGLE_SHEET_ID=1Wql_6lg_PQ1TT2xOF_5tv2AwA8Wy-PUWfeRPaVV-B_A
GOOGLE_SHEET_NAME=商品主檔

# 選填：關箱後的 LINE 群組通知（見 README「LINE 群組通知」）。三個都留空＝整個功能靜默略過，不影響關箱與存檔。
# 這三個現在是「備援」：建議改用設定頁（/settings，見 README「設定頁與 Volume」）設定，存檔立刻生效、不必重新部署。
# 設定頁裡存了 Channel access token 時，整組都以設定頁為準；設定頁沒有 token 時才用這裡的值。
# （這三個刻意留空：空字串代表「未設定」，填了假值反而會讓服務以為設定好了、推播失敗。）
# 推播用：LINE Messaging API 的 channel access token（長期）。要與 LINE_GROUP_ID 同時設定才會推播。
LINE_CHANNEL_ACCESS_TOKEN=
# 推播的目標群組 ID（C 開頭）。可用 POST /api/line/webhook 取得（做法見 README）。
LINE_GROUP_ID=
# channel secret：只給 webhook（取得群組 ID）驗簽用；沒設定時 POST /api/line/webhook 回 503。
LINE_CHANNEL_SECRET=

# 選填：設定頁的資料目錄（放 settings.json：管理密碼雜湊、LINE 設定…，內有 token，絕不進版控）。
# 本機預設 ./data（已在 .gitignore）；容器裡 Dockerfile 設成 /app/data，Zeabur 要把 Volume 掛在那裡
# （Dashboard → 服務 → 硬碟 → 掛載路徑 /app/data）。不可寫入時服務照常啟動，只有 /settings 回 503。
# 這個變數通常不用設；本機想換位置才設。
# DATA_DIR=./data

# 服務監聽埠（綁 0.0.0.0）。Zeabur 固定注入 PORT=8080；本機預設也是 8080。
PORT=8080
